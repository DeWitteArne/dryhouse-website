---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaCard from '@/components/CtaCard.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { cities, cityPath, type City } from '@/data/cities';
import { countries, localCountry, localRegion, regions } from '@/data/regions';
import { localService, serviceBySlug } from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import { paths, ui } from '@/i18n';

interface Props {
  city: City;
}

// City pages exist in Dutch only (the cities are Flemish and Dutch).
const lang = 'nl';
const t = ui[lang];
const { city } = Astro.props;
const region = localRegion(regions.find((r) => r.country === city.country && r.slug === city.region)!, lang);
const country = localCountry(countries[city.country], lang);
const path = cityPath(city);
const crumbs = [
  { name: t.home, path: paths.home[lang] },
  { name: t.footerArea, path: paths.werkgebied[lang] },
  { name: country.name, path: country.path },
  { name: region.name, path: region.path },
  { name: city.name, path },
];
const common = city.common.map(serviceBySlug).filter((s) => s !== undefined).map((s) => localService(s, lang));
const others = cities.filter((c) => c.slug !== city.slug);
---

<Base
  title={city.title}
  description={city.description}
  jsonLd={[serviceSchema({ name: `Vochtbestrijding ${city.name}`, description: city.intro, path, area: city.name, country: country.name }), breadcrumbSchema(crumbs), faqSchema(city.faq)]}
>
  <section class="bg-sand-100 pt-28 pb-20 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-8"><Icon name="pin" class="size-4" /> {city.name}, {region.name}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.5rem,1.6rem+3.8vw,4.75rem)] leading-[0.98] font-semibold">{city.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70 sm:text-xl">{city.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={paths.offerte[lang]} class="btn-primary">{t.requestQuote} <Icon name="arrow" class="size-4" /></a>
        <a href={paths.vochtcheck[lang]} class="btn-ghost">{t.doVochtcheck}</a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_22rem]">
      <div>
        <div class="prose-dh">
          {city.sections.map((s) => (
            <>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </>
          ))}
        </div>

        {city.projects.length > 0 && (
          <>
            <h2 class="mt-16 text-[1.9rem] leading-tight">Projecten in {city.name}</h2>
            <ul class="mt-6 grid gap-4 sm:grid-cols-2">
              {city.projects.map((p) => (
                <li class="card p-6">
                  <h3 class="text-xl font-semibold">{p.title}</h3>
                  <p class="mt-2 text-ink/65">{p.body}</p>
                </li>
              ))}
            </ul>
          </>
        )}

        <h2 class="mt-16 text-[1.9rem] leading-tight">Wat we in {city.name} vaak behandelen</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {common.map((s) => (
            <li>
              <a href={s.path} class="card group flex h-full flex-col p-5 transition-shadow hover:shadow-xl">
                <span class="grid size-11 place-items-center rounded-xl bg-tide-50 text-tide-500"><Icon name={s.icon} class="size-5" /></span>
                <span class="mt-4 font-semibold">{s.name}</span>
                <span class="mt-1 text-sm text-ink/60">{s.short}</span>
              </a>
            </li>
          ))}
        </ul>

        <h2 class="mt-16 text-[1.9rem] leading-tight">Ook in de buurt van {city.name}</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {city.areas.map((a) => <li class="rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink/8">{a}</li>)}
        </ul>
        <p class="mt-4 text-sm text-ink/65">We werken in heel <a href={region.path} class="font-semibold text-tide-500 hover:underline">{region.fullName ?? region.name}</a>.</p>
      </div>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <CtaCard title={`Advies of offerte in ${city.name}`} country={city.country} />
      </div>
    </div>
  </section>

  <Faq items={city.faq} title={`Vragen uit ${city.name}`} />

  <section class="border-t border-ink/10 py-16">
    <div class="container-x">
      <h2 class="text-xl font-semibold">Andere steden</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {others.map((c) => <li><a href={cityPath(c)} class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink/8 transition-colors hover:bg-tide-500 hover:text-white">{c.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
