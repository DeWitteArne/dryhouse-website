---
import Base from '@/layouts/Base.astro';
import BuildingStory from '@/components/react/BuildingStory';
import Hero from '@/components/home/Hero.astro';
import Specialisations from '@/components/home/Specialisations.astro';
import Process from '@/components/home/Process.astro';
import VochtcheckTeaser from '@/components/home/VochtcheckTeaser.astro';
import Regions from '@/components/home/Regions.astro';
import Faq from '@/components/Faq.astro';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';
import { homeFaq } from '@/data/faq';
import { faqSchema } from '@/lib/schema';
import { getPosts } from '@/lib/blog';
import { localService, serviceBySlug } from '@/data/services';
import { langFromUrl, other, paths, ui } from '@/i18n';

const lang = langFromUrl(Astro.url);
// The blog is Dutch only, so the French homepage leaves the articles out.
const posts = lang === 'nl' ? (await getPosts()).filter((p) => p.data.category === 'advies').slice(0, 3) : [];
const faq = homeFaq[lang];
const copy = {
  nl: {
    title: 'Vochtbestrijding, waterdichting en renovatie in België en Nederland',
    description: 'Dryhouse is specialist in vochtbestrijding, kelderdichting, gevelrenovatie, betonrotherstel, isolatie en coatings. Gratis diagnose in België en Nederland, tot 30 jaar garantie.',
    adviceEyebrow: 'Advies',
    adviceTitle: 'Meer weten over vocht in huis?',
    allPosts: 'Alle artikels',
  },
  fr: {
    title: 'Humidité, étanchéité et rénovation en Belgique et aux Pays-Bas',
    description: 'Dryhouse est spécialiste du traitement de l’humidité, de l’étanchéité de cave, de la rénovation de façade, du béton, de l’isolation et des revêtements. Diagnostic gratuit, jusqu’à 30 ans de garantie.',
    adviceEyebrow: '',
    adviceTitle: '',
    allPosts: '',
  },
}[lang];
const storyLinks = ['kelder-waterdicht-maken', 'liftputten', 'opstijgend-vocht', 'gevelrenovatie', 'betonrot-herstellen', 'ventilatie-schimmel'].map((slug) => localService(serviceBySlug(slug)!, lang).path);
---

<Base title={copy.title} description={copy.description} alternate={paths.home[other(lang)]} jsonLd={[faqSchema(faq)]}>
  <Hero />
  <Specialisations />
  <BuildingStory client:idle lang={lang} links={storyLinks} cta={{ label: ui[lang].requestQuote, href: paths.offerte[lang] }} />

  <Process />
  <VochtcheckTeaser />
  <Regions />

  {posts.length > 0 && (
    <section class="bg-white py-24 sm:py-32">
      <div class="container-x">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="eyebrow" data-reveal>{copy.adviceEyebrow}</p>
            <h2 class="mt-4 text-title" data-reveal>{copy.adviceTitle}</h2>
          </div>
          <a href={paths.blog[lang]} class="hidden items-center gap-2 font-semibold text-tide-500 sm:inline-flex">{copy.allPosts} <Icon name="arrow" class="size-4" /></a>
        </div>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
          {posts.map((post, i) => <PostCard post={post} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <Faq items={faq} />
</Base>
