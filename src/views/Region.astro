---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaCard from '@/components/CtaCard.astro';
import Icon from '@/components/Icon.astro';
import { countries, localCountry, localRegion, regionsIn, type Region } from '@/data/regions';
import { localService, services, serviceBySlug } from '@/data/services';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';
import { langFromUrl, other, paths, ui } from '@/i18n';

interface Props {
  region: Region;
}

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const region = localRegion(Astro.props.region, lang);
const country = localCountry(countries[region.country], lang);
const path = region.path;
const name = region.fullName ?? region.name;
const crumbs = [
  { name: t.home, path: paths.home[lang] },
  { name: t.footerArea, path: paths.werkgebied[lang] },
  { name: country.name, path: country.path },
  { name: region.name, path },
];
const common = region.common.map(serviceBySlug).filter((s) => s !== undefined).map((s) => localService(s, lang));
const neighbours = regionsIn(region.country).filter((r) => r.slug !== region.slug).map((r) => localRegion(r, lang));
const allServices = services.map((s) => localService(s, lang));
const cityList = region.cities.slice(0, 3).join(', ');
const copy = {
  nl: {
    title: `Vochtbestrijding ${name} | Gratis diagnose`,
    description: `Vochtproblemen ${region.inName}? Dryhouse behandelt opstijgend vocht, doorslaand vocht, schimmel en natte kelders in ${cityList} en omgeving. 30 jaar garantie.`,
    serviceName: `Vochtbestrijding ${name}`,
    h1: `Vochtbestrijding ${region.inName}`,
    problems: `Vochtproblemen ${region.inName}`,
    approach: 'Welk probleem je ook hebt, we beginnen altijd met een gratis diagnose bij je thuis. We meten het vocht, zoeken de oorzaak en geven je een duidelijke offerte. Op onze behandelingen krijg je tot 30 jaar garantie.',
    common: `Wat we ${region.inName} het vaakst behandelen`,
    towns: `Gemeenten ${region.inName}`,
    townsIntro: 'We komen onder meer langs in:',
    townsMissing: `Staat jouw gemeente er niet bij? We werken in heel ${name}, vraag gerust een diagnose aan.`,
    allServices: 'Al onze diensten',
    cta: `Gratis diagnose ${region.inName}`,
    others: `Andere provincies ${country.inName}`,
  },
  fr: {
    title: `Traitement de l’humidité ${region.inName} | Diagnostic gratuit`,
    description: `Problème d’humidité ${region.inName} ? Dryhouse traite l’humidité ascensionnelle, les infiltrations, les moisissures et les caves humides à ${cityList} et environs. 30 ans de garantie.`,
    serviceName: `Traitement de l’humidité ${region.inName}`,
    h1: `Traitement de l’humidité ${region.inName}`,
    problems: `Problèmes d’humidité ${region.inName}`,
    approach: 'Quel que soit votre problème, nous commençons toujours par un diagnostic gratuit chez vous. Nous mesurons l’humidité, cherchons la cause et vous remettons un devis clair. Nos traitements sont garantis jusqu’à 30 ans.',
    common: `Ce que nous traitons le plus souvent ${region.inName}`,
    towns: `Communes ${region.inName}`,
    townsIntro: 'Nous intervenons notamment à :',
    townsMissing: `Votre commune n’est pas dans la liste ? Nous intervenons partout ${region.inName}, n’hésitez pas à demander un diagnostic.`,
    allServices: 'Tous nos services',
    cta: `Diagnostic gratuit ${region.inName}`,
    others: `Autres provinces ${country.inName}`,
  },
}[lang];
---

<Base
  alternate={localRegion(Astro.props.region, other(lang)).path}
  title={copy.title}
  description={copy.description}
  jsonLd={[serviceSchema({ name: copy.serviceName, description: region.intro, path, area: name, country: country.name }), breadcrumbSchema(crumbs)]}
>
  <section class="bg-sand-100 pt-28 pb-20 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-8"><Icon name="pin" class="size-4" /> {region.name}, {country.name}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.5rem,1.6rem+3.8vw,4.75rem)] leading-[0.98] font-semibold">{copy.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70 sm:text-xl">{region.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={paths.offerte[lang]} class="btn-primary">{t.requestDiagnose} <Icon name="arrow" class="size-4" /></a>
        <a href={paths.vochtcheck[lang]} class="btn-ghost">{t.doVochtcheck}</a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_22rem]">
      <div>
        <div class="prose-dh">
          <h2>{copy.problems}</h2>
          <p>{region.context}</p>
          <p>{copy.approach}</p>
        </div>

        <h2 class="mt-16 text-[1.9rem] leading-tight">{copy.common}</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-3">
          {common.map((s) => (
            <li>
              <a href={s.path} class="card group flex h-full flex-col p-5 transition-shadow hover:shadow-xl">
                <span class="grid size-11 place-items-center rounded-xl bg-tide-50 text-tide-500"><Icon name={s.icon} class="size-5" /></span>
                <span class="mt-4 font-semibold">{s.name}</span>
                <span class="mt-1 text-sm text-ink/60">{s.short}</span>
              </a>
            </li>
          ))}
        </ul>

        <h2 class="mt-16 text-[1.9rem] leading-tight">{copy.towns}</h2>
        <p class="mt-3 text-ink/65">{copy.townsIntro}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {region.cities.map((c) => <li class="rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink/8">{c}</li>)}
        </ul>
        <p class="mt-4 text-sm text-ink/65">{copy.townsMissing}</p>

        <h2 class="mt-16 text-[1.9rem] leading-tight">{copy.allServices}</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {allServices.map((s) => <li><a href={s.path} class="inline-flex rounded-full bg-sand-100 px-4 py-2 text-sm font-medium transition-colors hover:bg-tide-500 hover:text-white">{s.name}</a></li>)}
        </ul>
      </div>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <CtaCard title={copy.cta} country={region.country} />
      </div>
    </div>
  </section>

  <section class="border-t border-ink/10 py-16">
    <div class="container-x">
      <h2 class="text-xl font-semibold">{copy.others}</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {neighbours.map((r) => <li><a href={r.path} class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-ink/8 transition-colors hover:bg-tide-500 hover:text-white">{r.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
