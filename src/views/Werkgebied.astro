---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { countries, localCountry, localRegion, regionsIn } from '@/data/regions';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import { langFromUrl, other, paths, ui } from '@/i18n';

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const crumbs = [
  { name: t.home, path: paths.home[lang] },
  { name: t.footerArea, path: paths.werkgebied[lang] },
];
const copy = {
  nl: {
    title: 'Werkgebied: vochtbestrijding in België en Nederland',
    description: 'Dryhouse behandelt vochtproblemen in heel België en in Nederland: van Vlaanderen, Brussel en Wallonië tot Zeeland, Brabant, Limburg en de Randstad. Gratis diagnose.',
    h1: 'Vochtbestrijding in België en Nederland.',
    intro: `Onze thuisbasis ligt in ${site.address.city}, vlak bij de Nederlandse grens. Van daaruit rijden onze ploegen door heel België en Nederland. Kies je provincie en ontdek welke vochtproblemen we daar het vaakst zien.`,
    around: 'en omgeving',
  },
  fr: {
    title: 'Zone d’intervention : traitement de l’humidité en Belgique et aux Pays-Bas',
    description: 'Dryhouse traite les problèmes d’humidité dans toute la Belgique et aux Pays-Bas : de la Flandre, Bruxelles et la Wallonie à la Zélande, au Brabant et au Limbourg. Diagnostic gratuit.',
    h1: 'Traitement de l’humidité en Belgique et aux Pays-Bas.',
    intro: `Notre base se trouve à ${site.address.city}, tout près de la frontière néerlandaise. De là, nos équipes interviennent dans toute la Belgique et aux Pays-Bas. Choisissez votre province et découvrez les problèmes d’humidité que nous y rencontrons le plus souvent.`,
    around: 'et environs',
  },
}[lang];
---

<Base title={copy.title} description={copy.description} alternate={paths.werkgebied[other(lang)]} jsonLd={[breadcrumbSchema(crumbs)]}>
  <section class="bg-sand-100 pt-28 pb-20 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-8 max-w-4xl text-display font-semibold">{copy.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 sm:text-xl">{copy.intro}</p>
    </div>
  </section>
  {Object.values(countries).map((country, i) => {
    const c = localCountry(country, lang);
    return (
      <section id={c.slug} class:list={['scroll-mt-24', i === 0 ? 'pt-20 pb-8' : 'pt-12 pb-24']}>
        <div class="container-x">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-title">{c.name}</h2>
            <a href={c.path} class="inline-flex items-center gap-2 font-semibold text-tide-500 hover:underline">
              {t.treatmentIn} {c.inName} <Icon name="arrow" class="size-4" />
            </a>
          </div>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {regionsIn(c.code).map((r) => localRegion(r, lang)).map((r, j) => (
              <li data-reveal style={`--reveal-i:${j % 3}`}>
                <a href={r.path} class="card group flex h-full flex-col p-7 transition-shadow hover:shadow-xl">
                  <span class="flex items-center justify-between">
                    <span class="font-display text-2xl font-semibold tracking-tight">{r.name}</span>
                    <Icon name="arrow" class="size-5 text-tide-500 transition-transform group-hover:translate-x-1" />
                  </span>
                  <span class="mt-3 text-[0.95rem] text-ink/60">{r.cities.slice(0, 5).join(', ')} {copy.around}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  })}
</Base>
