---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
const { address } = site;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Dryhouse, ${address.street}, ${address.postalCode} ${address.city}`)}`;
---

<Base
  title="Contact"
  description={`Contacteer Dryhouse: ${address.street}, ${address.postalCode} ${address.city}. Bel ${site.phoneDisplay} of mail ${site.email} voor een gratis vochtdiagnose.`}
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <section class="bg-sand-100 pt-28 pb-24 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-8 max-w-4xl text-display font-semibold">Laten we je huis droog maken.</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 sm:text-xl">Bel, mail of kom langs. Of vraag meteen een gratis diagnose aan.</p>

      <div class="mt-14 grid gap-4 md:grid-cols-3">
        <a href={`tel:${site.phone}`} class="card group p-7 transition-shadow hover:shadow-xl">
          <Icon name="phone" class="size-7 text-tide-500" />
          <p class="mt-6 text-sm font-semibold text-ink/50">Bel ons</p>
          <p class="mt-1 font-display text-2xl font-semibold tracking-tight">{site.phoneDisplay}</p>
          <p class="mt-2 text-sm text-ink/60">Nederland: {site.phoneNlDisplay}</p>
        </a>
        <a href={`mailto:${site.email}`} class="card group p-7 transition-shadow hover:shadow-xl">
          <Icon name="mail" class="size-7 text-tide-500" />
          <p class="mt-6 text-sm font-semibold text-ink/50">Mail ons</p>
          <p class="mt-1 font-display text-2xl font-semibold tracking-tight">{site.email}</p>
          <p class="mt-2 text-sm text-ink/60">We antwoorden zo snel mogelijk.</p>
        </a>
        <a href={mapsUrl} target="_blank" rel="noopener" class="card group p-7 transition-shadow hover:shadow-xl">
          <Icon name="pin" class="size-7 text-tide-500" />
          <p class="mt-6 text-sm font-semibold text-ink/50">Ons kantoor</p>
          <p class="mt-1 font-display text-2xl font-semibold tracking-tight">{address.street}</p>
          <p class="mt-2 text-sm text-ink/60">{address.postalCode} {address.city} · {site.openingHoursDisplay}</p>
        </a>
      </div>

      <div class="mt-4 flex flex-col items-start justify-between gap-6 rounded-3xl bg-tide-800 p-8 text-white sm:flex-row sm:items-center sm:p-10">
        <div>
          <p class="font-display text-3xl font-semibold tracking-tight">Gratis vochtdiagnose</p>
          <p class="mt-2 text-white/70">We komen langs, meten en zoeken de oorzaak. Vrijblijvend.</p>
        </div>
        <a href="/offerte-aanvragen" class="btn-light shrink-0">Diagnose aanvragen <Icon name="arrow" class="size-4" /></a>
      </div>

      <dl class="mt-12 grid gap-6 text-sm text-ink/60 sm:grid-cols-3">
        <div><dt class="font-semibold text-ink">Bedrijf</dt><dd class="mt-1">{site.legalName}</dd></div>
        <div><dt class="font-semibold text-ink">Ondernemingsnummer</dt><dd class="mt-1">{site.vat}</dd></div>
        <div><dt class="font-semibold text-ink">Volg ons</dt><dd class="mt-1 flex gap-4">{Object.entries(site.social).map(([n, url]) => <a href={url} target="_blank" rel="noopener" class="capitalize hover:text-ink">{n}</a>)}</dd></div>
      </dl>
    </div>
  </section>
</Base>
