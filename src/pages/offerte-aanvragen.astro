---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Gratis diagnose', path: '/offerte-aanvragen' },
];
const field = 'mt-2 block w-full rounded-xl border-0 bg-sand-50 px-4 py-3.5 text-ink ring-1 ring-ink/10 transition-shadow placeholder:text-ink/35 focus:bg-white focus:ring-2 focus:ring-tide-500 focus:outline-none';
const label = 'block text-sm font-semibold';
---

<Base
  title="Gratis vochtdiagnose en offerte aanvragen"
  description="Vraag gratis en vrijblijvend een vochtdiagnose aan. Een specialist van Dryhouse meet het vocht, zoekt de oorzaak en bezorgt je een heldere offerte."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <section class="bg-sand-100 pt-28 pb-24 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_1.5fr]">
        <div>
          <h1 class="text-[clamp(2.4rem,1.6rem+3.4vw,4.5rem)] leading-[0.98] font-semibold">Gratis vochtdiagnose aanvragen</h1>
          <p class="mt-6 text-lg leading-relaxed text-ink/70">
            Vertel ons kort wat er aan de hand is. Een specialist neemt contact met je op om een diagnose bij je thuis in te plannen. Gratis en vrijblijvend.
          </p>
          <ol class="mt-10 space-y-5">
            {['Je vult het formulier in', 'We bellen je om een afspraak te maken', 'We meten ter plaatse en zoeken de oorzaak', 'Je krijgt een heldere offerte met garantie'].map((s, i) => (
              <li class="flex items-center gap-4">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white font-display font-semibold text-tide-500 ring-1 ring-ink/5">{i + 1}</span>
                <span class="font-medium">{s}</span>
              </li>
            ))}
          </ol>
          <div class="mt-12 rounded-2xl bg-white p-6 ring-1 ring-ink/5">
            <p class="font-semibold">Liever bellen of mailen?</p>
            <p class="mt-3 flex items-center gap-2"><Icon name="phone" class="size-5 text-tide-500" /><a href={`tel:${site.phone}`} class="font-medium hover:underline">{site.phoneDisplay}</a><span class="text-sm text-ink/65">België</span></p>
            <p class="mt-2 flex items-center gap-2"><Icon name="phone" class="size-5 text-tide-500" /><a href={`tel:${site.phoneNl}`} class="font-medium hover:underline">{site.phoneNlDisplay}</a><span class="text-sm text-ink/65">Nederland</span></p>
            <p class="mt-2 flex items-center gap-2"><Icon name="mail" class="size-5 text-tide-500" /><a href={`mailto:${site.email}`} class="font-medium hover:underline">{site.email}</a></p>
            <p class="mt-2 flex items-center gap-2 text-sm text-ink/60"><Icon name="clock" class="size-5 text-tide-500" />{site.openingHoursDisplay}</p>
          </div>
        </div>

        <form id="offerte" method="post" action="/api/offerte" enctype="multipart/form-data" class="card space-y-6 p-6 sm:p-10">
          <div id="form-error" hidden class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900 ring-1 ring-amber-200" role="alert">
            Er ging iets mis bij het versturen. Probeer het opnieuw, of bel ons op <a class="font-semibold underline" href={`tel:${site.phone}`}>{site.phoneDisplay}</a> (België) of <a class="font-semibold underline" href={`tel:${site.phoneNl}`}>{site.phoneNlDisplay}</a> (Nederland).
          </div>
          <fieldset>
            <legend class={label}>Waarvoor wil je een diagnose? <span class="text-tide-500">*</span></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {[...services.map((s) => ({ value: s.slug, name: s.name })), { value: 'iets-anders', name: 'Iets anders' }].map((s) => (
                <label class="cursor-pointer">
                  <input type="checkbox" name="probleem" value={s.value} class="peer sr-only" />
                  <span class="inline-flex rounded-full bg-sand-50 px-4 py-2.5 text-sm font-medium ring-1 ring-ink/10 transition-all peer-checked:bg-tide-500 peer-checked:text-white peer-checked:ring-tide-500 peer-focus-visible:ring-2 peer-focus-visible:ring-spark hover:ring-tide-500/40">{s.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class={label}>Voornaam <span class="text-tide-500">*</span><input name="voornaam" required autocomplete="given-name" class={field} /></label>
            <label class={label}>Familienaam <span class="text-tide-500">*</span><input name="familienaam" required autocomplete="family-name" class={field} /></label>
            <label class={label}>E-mail <span class="text-tide-500">*</span><input name="email" type="email" required autocomplete="email" class={field} /></label>
            <label class={label}>Telefoon <span class="text-tide-500">*</span><input name="telefoon" type="tel" required autocomplete="tel" class={field} /></label>
          </div>
          <div class="grid gap-5 sm:grid-cols-[2fr_1fr]">
            <label class={label}>Straat en nummer <span class="text-tide-500">*</span><input name="straat" required autocomplete="street-address" class={field} /></label>
            <label class={label}>Postcode <span class="text-tide-500">*</span><input name="postcode" required autocomplete="postal-code" class={field} /></label>
          </div>
          <div class="grid gap-5 sm:grid-cols-[2fr_1fr]">
            <label class={label}>Gemeente <span class="text-tide-500">*</span><input name="gemeente" required autocomplete="address-level2" class={field} /></label>
            <label class={label}>Land
              <select name="land" autocomplete="country-name" class={field}>
                <option>België</option>
                <option>Nederland</option>
              </select>
            </label>
          </div>
          <label class={label}>Omschrijf je probleem of stel je vraag <span class="text-tide-500">*</span>
            <textarea name="omschrijving" required rows="5" placeholder="Bv. sinds de winter zie ik een witte rand onderaan de muur in de woonkamer…" class={field}></textarea>
          </label>
          <label class={label}>Foto's (optioneel, max. 3)
            <span class="mt-1 block text-sm font-normal text-ink/65">Een foto helpt ons om je situatie al in te schatten.</span>
            <input name="fotos" type="file" accept="image/*" multiple class="mt-3 block w-full text-sm file:mr-4 file:rounded-full file:border-0 file:bg-tide-50 file:px-4 file:py-2.5 file:font-semibold file:text-tide-600 hover:file:bg-tide-100" />
          </label>
          <!-- Honeypot: real visitors never see or fill this field. -->
          <div aria-hidden="true" class="absolute -left-[9999px]"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <label class="flex gap-3 text-sm text-ink/70">
            <input type="checkbox" name="akkoord" required class="mt-0.5 size-5 shrink-0 rounded accent-tide-500" />
            <span>Ik ga akkoord dat Dryhouse mijn gegevens gebruikt om mijn aanvraag te behandelen, zoals beschreven in de <a href="/privacy" class="font-semibold text-tide-500 underline">privacyverklaring</a>.</span>
          </label>
          <button type="submit" class="btn-primary w-full sm:w-auto">Verstuur aanvraag <Icon name="arrow" class="size-4" /></button>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { currentLand } from '@/lib/country';

  const form = document.getElementById('offerte') as HTMLFormElement;
  const error = document.getElementById('form-error')!;
  const params = new URLSearchParams(location.search);

  // Prefill the problem type when coming from the vochtcheck or a service page.
  const pre = params.get('probleem');
  if (pre) form.querySelector<HTMLInputElement>(`input[name="probleem"][value="${CSS.escape(pre)}"]`)?.click();
  if (params.has('fout')) error.hidden = false;
  if (currentLand() === 'nl') form.querySelector<HTMLSelectElement>('select[name="land"]')!.value = 'Nederland';

  form.addEventListener('submit', async (e) => {
    const checked = form.querySelectorAll('input[name="probleem"]:checked').length;
    if (!checked) {
      e.preventDefault();
      form.querySelector<HTMLInputElement>('input[name="probleem"]')?.focus();
      alert('Kies waarvoor je een diagnose wil.');
      return;
    }
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Versturen…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      location.href = '/bedankt';
    } catch {
      error.hidden = false;
      error.scrollIntoView({ behavior: 'smooth', block: 'center' });
      button.disabled = false;
      button.textContent = 'Verstuur aanvraag';
    }
  });
</script>
