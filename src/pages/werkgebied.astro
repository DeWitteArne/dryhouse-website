---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { countries, countryPath, regionPath, regionsIn } from '@/data/regions';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Werkgebied', path: '/werkgebied' },
];
---

<Base
  title="Werkgebied: vochtbestrijding in België en Nederland"
  description="Dryhouse behandelt vochtproblemen in heel België en in Nederland: van Vlaanderen, Brussel en Wallonië tot Zeeland, Brabant, Limburg en de Randstad. Gratis diagnose."
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <section class="bg-sand-100 pt-28 pb-20 grain sm:pt-32">
    <div class="container-x">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-8 max-w-4xl text-display font-semibold">Vochtbestrijding in België en Nederland.</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 sm:text-xl">
        Onze thuisbasis ligt in {site.address.city}, vlak bij de Nederlandse grens. Van daaruit rijden onze ploegen door heel België en Nederland. Kies je provincie en ontdek welke vochtproblemen we daar het vaakst zien.
      </p>
    </div>
  </section>
  {Object.values(countries).map((c, i) => (
    <section id={c.slug} class:list={['scroll-mt-24', i === 0 ? 'pt-20 pb-8' : 'pt-12 pb-24']}>
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-title">{c.name}</h2>
          <a href={countryPath(c)} class="inline-flex items-center gap-2 font-semibold text-tide-500 hover:underline">
            Vochtbestrijding {c.inName} <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {regionsIn(c.code).map((r, i) => (
            <li data-reveal style={`--reveal-i:${i % 3}`}>
              <a href={regionPath(r)} class="card group flex h-full flex-col p-7 transition-shadow hover:shadow-xl">
                <span class="flex items-center justify-between">
                  <span class="font-display text-2xl font-semibold tracking-tight">{r.name}</span>
                  <Icon name="arrow" class="size-5 text-tide-500 transition-transform group-hover:translate-x-1" />
                </span>
                <span class="mt-3 text-[0.95rem] text-ink/60">{r.cities.slice(0, 5).join(', ')} en omgeving</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
