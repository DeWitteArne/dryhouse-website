---
import Icon from '../Icon.astro';
import { langFromUrl, paths } from '@/i18n';

const lang = langFromUrl(Astro.url);
const copy = {
  nl: {
    eyebrow: 'Online vochtcheck',
    title: 'Wat is er aan de hand met je muur?',
    text: 'Beantwoord vijf korte vragen en ontdek in één minuut welk vochtprobleem je waarschijnlijk hebt, en wat eraan te doen is.',
    button: 'Start de vochtcheck',
    recognise: 'Herken je dit?',
    symptoms: ['Zoutrand onderaan de muur', 'Bladderende verf', 'Muffe geur', 'Beslagen ramen', 'Zwarte schimmelvlekken', 'Natte kelder', 'Vochtvlekken na regen'],
  },
  fr: {
    eyebrow: 'Test d’humidité en ligne',
    title: 'Que se passe-t-il avec votre mur ?',
    text: 'Répondez à cinq questions courtes et découvrez en une minute quel problème d’humidité vous avez probablement, et comment le résoudre.',
    button: 'Commencer le test',
    recognise: 'Cela vous dit quelque chose ?',
    symptoms: ['Traces de salpêtre en bas du mur', 'Peinture qui cloque', 'Odeur de moisi', 'Vitres embuées', 'Taches noires de moisissure', 'Cave humide', 'Taches d’humidité après la pluie'],
  },
}[lang];
const { symptoms } = copy;
---

<section class="py-24 sm:py-32">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-sand-100 px-6 py-14 ring-1 ring-ink/5 grain sm:px-12 lg:px-16 lg:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
          <h2 class="mt-4 text-title" data-reveal>{copy.title}</h2>
          <p class="mt-6 max-w-lg text-lg text-ink/70" data-reveal>{copy.text}</p>
          <a href={paths.vochtcheck[lang]} class="btn-primary mt-8" data-reveal>{copy.button} <Icon name="arrow" class="size-4" /></a>
        </div>
        <div class="relative" aria-hidden="true">
          <p class="mb-4 text-sm font-semibold text-ink/50">{copy.recognise}</p>
          <ul class="flex flex-wrap gap-2.5">
            {symptoms.map((s, i) => (
              <li data-reveal style={`--reveal-i:${i}`} class="rounded-full bg-white px-4 py-2.5 text-[0.95rem] font-medium shadow-sm ring-1 ring-ink/5">
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
