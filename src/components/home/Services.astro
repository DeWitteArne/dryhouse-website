---
import Icon from '../Icon.astro';
import { localService, services } from '@/data/services';
import { langFromUrl } from '@/i18n';

const lang = langFromUrl(Astro.url);
const items = services.map((s) => localService(s, lang));
const main = items.filter((s) => s.group === 'vocht');
const rest = items.filter((s) => s.group !== 'vocht');
const copy = {
  nl: {
    eyebrow: 'Wat we oplossen',
    title: 'Elk vochtprobleem heeft een oorzaak. Wij vinden ze.',
    text: 'Geen standaardoplossing, maar de juiste behandeling voor jouw muur, kelder of gevel. Met garantie.',
    more: (name: string) => `Meer over ${name.toLowerCase()}`,
  },
  fr: {
    eyebrow: 'Ce que nous résolvons',
    title: 'Chaque problème d’humidité a une cause. Nous la trouvons.',
    text: 'Pas de solution standard, mais le bon traitement pour votre mur, votre cave ou votre façade. Avec garantie.',
    more: () => 'En savoir plus',
  },
}[lang];
---

<section id="diensten" class="relative py-24 sm:py-32">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
        <h2 class="mt-4 text-title" data-reveal>{copy.title}</h2>
      </div>
      <p class="max-w-md text-lg text-ink/65" data-reveal>{copy.text}</p>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {main.map((s, i) => (
        <li data-reveal style={`--reveal-i:${i}`}>
          <a href={s.path} class="group card relative flex h-full min-h-[19rem] flex-col overflow-hidden p-7 transition-colors duration-500 hover:text-white">
            <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0 bg-tide-500 transition-[height] duration-700 ease-(--ease-out-expo) group-hover:h-full"></span>
            <span class="relative grid size-12 place-items-center rounded-2xl bg-tide-50 text-tide-500 transition-colors duration-500 group-hover:bg-white/15 group-hover:text-white">
              <Icon name={s.icon} />
            </span>
            <span class="relative mt-auto block pt-10">
              <span class="block font-display text-2xl font-semibold tracking-tight">{s.name}</span>
              <span class="mt-2 block text-[0.95rem] leading-relaxed text-ink/60 transition-colors duration-500 group-hover:text-white/80">{s.short}</span>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-tide-500 transition-colors duration-500 group-hover:text-white">
                {copy.more(s.name)} <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {rest.map((s, i) => (
        <li data-reveal style={`--reveal-i:${i}`}>
          <a href={s.path} class="group flex h-full items-center gap-4 rounded-2xl bg-sand-100 p-5 ring-1 ring-ink/5 transition-all duration-300 hover:bg-white hover:shadow-lg">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white text-tide-500 transition-colors group-hover:bg-tide-500 group-hover:text-white"><Icon name={s.icon} class="size-5" /></span>
            <span class="font-semibold">{s.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
