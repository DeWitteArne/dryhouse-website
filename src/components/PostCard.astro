---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { postUrl, formatDate } from '@/lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, description, heroImage, heroAlt, pubDate } = post.data;
---

<article class="group relative flex h-full flex-col" data-reveal style={`--reveal-i:${index % 3}`}>
  <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand-200">
    {heroImage ? (
      <Image src={heroImage} alt={heroAlt ?? ''} widths={[400, 600, 800]} sizes="(min-width: 768px) 33vw, 100vw" class="size-full object-cover transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-105" />
    ) : (
      <div class="grid size-full place-items-center bg-gradient-to-br from-tide-500 to-tide-800 p-8 font-display text-2xl text-white/90">{title}</div>
    )}
  </div>
  <time datetime={pubDate.toISOString()} class="mt-5 text-sm text-ink/50">{formatDate(pubDate)}</time>
  <h3 class="mt-2 text-xl leading-snug font-semibold tracking-tight">
    <a href={postUrl(post)} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="mt-2 line-clamp-2 text-[0.95rem] text-ink/60">{description}</p>
</article>
