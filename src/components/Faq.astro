---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Veelgestelde vragen' } = Astro.props;
---

<section class="py-24 sm:py-32">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="eyebrow" data-reveal>FAQ</p>
      <h2 class="mt-4 text-title" data-reveal>{title}</h2>
    </div>
    <div class="divide-y divide-ink/10 border-y border-ink/10">
      {items.map((item) => (
        <details class="group py-2" name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-xl font-medium tracking-tight [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sand-100 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="max-w-2xl pb-5 leading-relaxed text-ink/70">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
