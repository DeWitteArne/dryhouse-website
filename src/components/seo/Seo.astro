---
import { site } from '@/data/site';
import { langFromUrl } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** The same page in the other language (path), if it exists. */
  alternate?: string;
}

const {
  title,
  description,
  image = '/og/default.jpg',
  imageAlt = 'Dryhouse vochtbestrijding',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
  alternate,
} = Astro.props;
const lang = langFromUrl(Astro.url);

// Preview/POC hosts (*.pages.dev) get `X-Robots-Tag: noindex` from public/_headers,
// so the live domain is indexable by default and nothing needs flipping at launch.
const indexable = !noindex;
// Pages are built as /contact.html but served (and canonical) as /contact.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const imageUrl = new URL(image, site.url).href;
const fullTitle = title.includes('Dryhouse') ? title : `${title} | Dryhouse`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow'} />
{
  // Dutch serves Belgium and the Netherlands; French is for every French speaker.
  [
    ['nl-BE', lang === 'nl' ? canonical : alternate],
    ['nl-NL', lang === 'nl' ? canonical : alternate],
    ['fr', lang === 'fr' ? canonical : alternate],
    ['x-default', lang === 'nl' ? canonical : alternate],
  ]
    .filter(([, href]) => href)
    .map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={new URL(href!, site.url).href} />)
}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'nl_BE'} />
{(lang === 'fr' ? ['nl_BE', 'nl_NL'] : alternate ? ['nl_NL', 'fr_BE'] : ['nl_NL']).map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
