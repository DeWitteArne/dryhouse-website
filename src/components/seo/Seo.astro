---
import { site } from '@/data/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og/default.jpg',
  imageAlt = 'Dryhouse vochtbestrijding',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Preview/POC hosts (*.pages.dev) get `X-Robots-Tag: noindex` from public/_headers,
// so the live domain is indexable by default and nothing needs flipping at launch.
const indexable = !noindex;
// Pages are built as /contact.html but served (and canonical) as /contact.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const imageUrl = new URL(image, site.url).href;
const fullTitle = title.includes('Dryhouse') ? title : `${title} | Dryhouse`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow'} />
<link rel="alternate" hreflang="nl-BE" href={canonical} />
<link rel="alternate" hreflang="nl-NL" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:locale" content="nl_BE" />
<meta property="og:locale:alternate" content="nl_NL" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
