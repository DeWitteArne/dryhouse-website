---
/**
 * The Dryhouse logo (house + drop, "DRY HOUSE"), vectorised from the original
 * artwork. `white` is the version for dark backgrounds.
 */
interface Props {
  tone?: 'color' | 'white';
  class?: string;
}
const { tone = 'color', class: className = 'h-9 sm:h-10' } = Astro.props;
const src = tone === 'white' ? '/images/brand/dryhouse-logo-white.svg' : '/images/brand/dryhouse-logo.svg';
---

<img src={src} alt="Dryhouse" width="445" height="108" class:list={['w-auto', className]} decoding="async" />
