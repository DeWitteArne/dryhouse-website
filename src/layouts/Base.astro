---
import '@/styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import Seo, { type Props as SeoProps } from '@/components/seo/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import Assistant from '@/components/react/Assistant';
import { businessSchema, websiteSchema } from '@/lib/schema';
import { langFromUrl, ui } from '@/i18n';

export interface Props extends SeoProps {
  /** Header sits over a dark hero: start with light text. */
  headerTone?: 'light' | 'dark';
}

const { headerTone = 'dark', jsonLd = [], ...seo } = Astro.props;
const lang = langFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a5086" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} jsonLd={[businessSchema(lang), websiteSchema(), ...jsonLd]} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-dvh overflow-x-clip max-md:pb-[4.5rem]">
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">
      {ui[lang].skip}
    </a>
    <Header tone={headerTone} alternate={seo.alternate} />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <Assistant client:idle lang={lang} />
    <script>
      import { initReveal } from '@/lib/reveal';
      import { initCountry } from '@/lib/country';
      initReveal();
      initCountry();
    </script>
  </body>
</html>
